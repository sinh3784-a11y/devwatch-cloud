generator client {
    provider = "prisma-client"
    output = "../src/generated/prisma"
    moduleFormat = "esm"
}

datasource db {
    provider = "postgresql"
}

enum ProjectStatus {
    ACTIVE
    PAUSED
}

enum ErrorLevel {
    WARN
    ERROR
    FATAL
}

model User {
    id  String  @id @default(uuid()) @db.Uuid()
    email String @unique    @db.VarChar(254)
    passwordHash    String @map("passwoard_hash") @db.Text()

    project Project[]

    createdAt   DateTime @default(now())  @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("users")
}

model Project {
    id  String      @id @default(uuid()) @db.Uuid
    name String     @db.VarChar(100)
    nameKey String  @map("name_key")  @db.VarChar(100)
    description  String? @db.Text
    status    ProjectStatus     @default(ACTIVE)

    createdAt   DateTime @default(now())  @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    apiKeys ProjectApiKey[]
    events ErrorEvent[]

    ownerId String? @map("owner_id") @db.Uuid()

    owner User?  @relation(fields: [ownerId], references: [id], onDelete: Restrict)

    @@unique([ownerId, nameKey]) //Composite Unique Constraint
    @@index([ownerId])
    @@map("projects")
}

model ProjectApiKey {
    id  String @id @default(uuid()) @db.Uuid
    projectId   String @map("project_id") @db.Uuid

    label   String @db.VarChar(60)
    keyHash String @map("key_hash") @db.VarChar(40)

    expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
    revokedAt DateTime?  @map("revoked_at") @db.Timestamptz(3)

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@map("project_api_keys")
}

model ErrorEvent {
    id  String @id @default(uuid()) @db.Uuid
    projectId   String @map("project_id") @db.Uuid

    level   ErrorLevel
    source  String  @db.VarChar(80)
    message String  @db.Text
    stack   String? @db.Text

    occurredAt  DateTime   @map("occurred_at") @db.Timestamptz(3)
    receivedAt  DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId,receivedAt])
    @@map("error_events")
}